{
  "name": "htwsuite-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "HTW Media desktop client (Electron) — wraps the HTW platform V2 API. Agent skills live in ../../agent.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.htwmedia.desktop",
    "productName": "HTW Media",
    "icon": "assets/icon.ico",
    "files": [
      "**/*",
      "assets/icon.ico"
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0"
  },
  "optionalDependencies": {
    "electron-builder": "^24.0.0"
  }
}
